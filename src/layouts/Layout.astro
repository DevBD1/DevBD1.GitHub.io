---
import { MarketThemeProvider } from '../context/MarketThemeContext.tsx';
import { fetchBitcoinSentiment } from '../lib/market';
import '../styles/global.css';

// Server-side fetch (SSR) for initial state
const initialData = await fetchBitcoinSentiment();
---

<!DOCTYPE html>
<html lang="en" data-theme={initialData.sentiment.toLowerCase()}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Burak | FinTech Engineer</title>
  </head>
  <body>
    <!-- Wrap everything in the Market Context -->
    <MarketThemeProvider initialData={initialData} client:load>
      <slot />
    </MarketThemeProvider>
  </body>
</html>
