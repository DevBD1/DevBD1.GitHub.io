---
import { MarketProvider } from '../components/MarketProvider';
import { fetchBitcoinSentiment } from '../lib/market';
import '../styles/global.css';

// Server-side fetch (SSR) for initial state
const initialData = await fetchBitcoinSentiment();
---

<!DOCTYPE html>
<html lang="en" data-theme={initialData.sentiment.toLowerCase()}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Burak | FinTech Engineer</title>
  </head>
  <body>
    <!-- Hydrate the store with initial data -->
    <MarketProvider initialData={initialData} client:load />
    <slot />
  </body>
</html>
