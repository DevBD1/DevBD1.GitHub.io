---
import Layout from '../layouts/Layout.astro';
import SkillTicker from '../components/SkillTicker.tsx';
import Typewriter from '../components/Typewriter.tsx';
import ProjectCard from '../components/ProjectCard.tsx';
import { siteConfig } from '../config/site.config';
import { profile, projects, experiences, education, skills, skillCategories } from '../data';

const { features } = siteConfig;
---

<Layout>
  <!-- Skill Ticker at top -->
  {features.skillTicker && <SkillTicker client:load />}

  <main class="container mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- HERO SECTION -->
    <section id="about" class="flex flex-col items-center justify-center min-h-[85vh] text-center space-y-4 sm:space-y-6 py-12">
      
      <div class="space-y-2">
        <p class="text-lg sm:text-xl font-mono" style="color: var(--color-secondary);">Hello, I'm</p>
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tighter">
          <span class="text-slate-200">{profile.name}</span>
          <span class="text-[var(--color-primary)]">.{profile.surname}</span>
        </h1>
      </div>

      <!-- Typewriter Animation -->
      {features.typewriter && (
        <div class="h-6 sm:h-8 text-base sm:text-xl md:text-2xl font-mono">
          <Typewriter client:load />
        </div>
      )}

      <!-- Location -->
      <div class="flex items-center gap-2 font-mono text-xs sm:text-sm" style="color: var(--color-secondary);">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
        </svg>
        {profile.location}
      </div>
      
      <!-- Summary -->
      <p class="text-base sm:text-lg max-w-2xl sm:max-w-3xl leading-relaxed px-2 sm:px-0" style="color: var(--color-secondary);">
        {profile.summary}
      </p>

      <!-- Highlights -->
      <div class="flex flex-wrap justify-center gap-2 sm:gap-4 pt-2 sm:pt-4">
        {profile.highlights.map((highlight) => (
          <span class="px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm border" 
            style="background-color: rgba(100, 116, 139, 0.1); border-color: var(--color-accent); color: var(--color-text-base);">
            {highlight}
          </span>
        ))}
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 pt-4 sm:pt-6 w-full sm:w-auto px-4 sm:px-0">
        {features.resumeDownload && (
          <div class="relative group w-full sm:w-auto">
            <button class="w-full sm:w-auto px-6 sm:px-8 py-3 font-bold rounded transition-opacity hover:opacity-90 flex items-center justify-center gap-2"
              style="background-color: var(--color-primary); color: var(--color-bg-base);">
              My Resume
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </button>
            
            <div class="absolute top-full left-0 right-0 sm:right-auto sm:w-full mt-2 bg-slate-800 border rounded shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-10 overflow-hidden"
              style="border-color: var(--color-accent);">
              <a href="#" class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-white text-left">PDF</a>
              <a href="#" class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-white text-left">Word</a>
            </div>
          </div>
        )}

        <a href="#contact" class="w-full sm:w-auto px-6 sm:px-8 py-3 border rounded transition-colors hover:bg-slate-800/50 flex items-center justify-center gap-2 text-center"
          style="border-color: var(--color-accent); color: var(--color-text-base);">
          Contact Info
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      </div>

    </section>

    <!-- EXPERIENCE SECTION -->
    {features.experience && (
      <section id="experience" class="py-12 sm:py-20">
        <h2 class="text-2xl sm:text-3xl font-bold mb-8 sm:mb-12 font-mono border-b pb-4 flex items-center gap-3"
          style="border-color: var(--color-accent);">
          <span class="text-[var(--color-primary)]">></span> Experience
        </h2>

        <div class="space-y-6 sm:space-y-8">
          {experiences.map((exp) => (
            <div class="rounded-lg p-4 sm:p-6 transition-colors hover:border-opacity-80"
              style="background-color: rgba(15, 23, 42, 0.3); border: 1px solid var(--color-accent);">
              <div class="flex flex-col gap-2 sm:gap-0 sm:flex-row sm:justify-between sm:items-start mb-4">
                <div>
                  <h3 class="text-lg sm:text-xl font-bold text-slate-200">{exp.position}</h3>
                  <p class="font-medium text-[var(--color-primary)]">{exp.company}</p>
                </div>
                <div class="text-xs sm:text-sm font-mono" style="color: var(--color-secondary);">
                  {exp.startDate} — {exp.endDate}
                </div>
              </div>
              
              <p class="text-sm sm:text-base mb-4" style="color: var(--color-secondary);">{exp.description}</p>
              
              <ul class="space-y-2 mb-4">
                {exp.achievements.map((achievement) => (
                  <li class="flex items-start gap-2 text-sm" style="color: var(--color-text-base);">
                    <span class="text-[var(--color-primary)] mt-0.5">▸</span>
                    {achievement}
                  </li>
                ))}
              </ul>
              
              <div class="flex flex-wrap gap-2">
                {exp.technologies.map((tech) => (
                  <span class="px-2 py-1 text-xs font-mono rounded border"
                    style="background-color: rgba(100, 116, 139, 0.15); border-color: var(--color-accent); color: var(--color-secondary);">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- PROJECTS SECTION -->
    {features.projects && (
      <section id="projects" class="py-12 sm:py-20">
        <h2 class="text-2xl sm:text-3xl font-bold mb-8 sm:mb-12 font-mono border-b pb-4 flex items-center gap-3"
          style="border-color: var(--color-accent);">
          <span class="text-[var(--color-primary)]">></span> Proof_of_Work
          <span class="text-xs sm:text-sm font-normal ml-auto" style="color: var(--color-secondary);">Latest Blocks Mined</span>
        </h2>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
          {projects.map((project) => (
            <ProjectCard 
              client:visible
              {...project}
            />
          ))}
        </div>
      </section>
    )}

    <!-- SKILLS SECTION -->
    {features.skills && (
      <section id="skills" class="py-12 sm:py-20">
        <h2 class="text-2xl sm:text-3xl font-bold mb-8 sm:mb-12 font-mono border-b pb-4 flex items-center gap-3"
          style="border-color: var(--color-accent);">
          <span class="text-[var(--color-primary)]">></span> Skills
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
          {skillCategories.map((category) => {
            const categorySkills = skills.filter((s) => s.category === category.key);
            if (categorySkills.length === 0) return null;
            
            return (
              <div class="rounded-lg p-4 sm:p-6"
                style="background-color: rgba(15, 23, 42, 0.3); border: 1px solid var(--color-accent);">
                <h3 class="text-base sm:text-lg font-bold mb-4 font-mono" style="color: var(--color-text-base);">{category.label}</h3>
                
                <div class="space-y-3">
                  {categorySkills.map((skill) => (
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-2">
                        <span class="font-mono text-xs" style="color: var(--color-secondary);">{skill.symbol}</span>
                        <span class="text-sm" style="color: var(--color-text-base);">{skill.name}</span>
                      </div>
                      <span class="text-xs font-mono text-[var(--color-primary)]">{skill.change}</span>
                    </div>
                  ))}
                </div>              
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- EDUCATION SECTION -->
    {features.education && (
      <section id="education" class="py-12 sm:py-20">
        <h2 class="text-2xl sm:text-3xl font-bold mb-8 sm:mb-12 font-mono border-b pb-4 flex items-center gap-3"
          style="border-color: var(--color-accent);">
          <span class="text-[var(--color-primary)]">></span> Education
        </h2>

        <div class="space-y-6 sm:space-y-8">
          {education.map((edu) => (
            <div class="rounded-lg p-4 sm:p-6"
              style="background-color: rgba(15, 23, 42, 0.3); border: 1px solid var(--color-accent);">
              <div class="flex flex-col gap-2 sm:gap-0 sm:flex-row sm:justify-between sm:items-start mb-4">
                <div>
                  <h3 class="text-lg sm:text-xl font-bold text-slate-200">{edu.institution}</h3>
                  <p style="color: var(--color-secondary);">{edu.degree} in {edu.field}</p>
                </div>
                <div class="text-xs sm:text-sm font-mono" style="color: var(--color-secondary);">
                  {edu.startDate} — {edu.endDate}
                </div>
              </div>
              
              <ul class="space-y-2">
                {edu.highlights.map((highlight) => (
                  <li class="flex items-start gap-2 text-sm" style="color: var(--color-text-base);">
                    <span class="text-[var(--color-primary)] mt-0.5">▸</span>
                    {highlight}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- CONTACT SECTION -->
    {features.contact && (
      <section id="contact" class="py-12 sm:py-20">
        <h2 class="text-2xl sm:text-3xl font-bold mb-8 sm:mb-12 font-mono border-b pb-4 flex items-center gap-3"
          style="border-color: var(--color-accent);">
          <span class="text-[var(--color-primary)]">></span> Contact
        </h2>

        <div class="rounded-lg p-6 sm:p-8 max-w-2xl"
          style="background-color: rgba(15, 23, 42, 0.3); border: 1px solid var(--color-accent);">
          <p class="mb-6 text-sm sm:text-base" style="color: var(--color-secondary);">
            Interested in working together? Feel free to reach out.
          </p>

          <div class="space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
              <span class="font-mono text-sm" style="color: var(--color-secondary);">Email:</span>
              <a href={`mailto:${profile.email}`} class="text-[var(--color-primary)] hover:underline text-sm sm:text-base">
                {profile.email}
              </a>
            </div>
            
            <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
              <span class="font-mono text-sm" style="color: var(--color-secondary);">Location:</span>
              <span class="text-sm sm:text-base" style="color: var(--color-text-base);">{profile.location}</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 mt-8">
            {profile.socials.github && (
              <a 
                href={profile.socials.github} 
                target="_blank" 
                rel="noopener"
                class="px-4 sm:px-6 py-3 rounded transition-colors flex items-center justify-center sm:justify-start gap-2 text-sm"
                style="background-color: rgba(100, 116, 139, 0.15); color: var(--color-text-base);"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                GitHub
              </a>
            )}
            {profile.socials.linkedin && (
              <a 
                href={profile.socials.linkedin} 
                target="_blank" 
                rel="noopener"
                class="px-4 sm:px-6 py-3 rounded transition-colors flex items-center justify-center sm:justify-start gap-2 text-sm"
                style="background-color: rgba(100, 116, 139, 0.15); color: var(--color-text-base);"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                LinkedIn
              </a>
            )}
          </div>
        </div>
      </section>
    )}

  </main>
</Layout>