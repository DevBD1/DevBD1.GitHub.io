---
import Layout from '../layouts/Layout.astro';
import SkillTicker from '../components/SkillTicker';
import Typewriter from '../components/Typewriter';

---

<Layout>
  <!-- Ticker at the top for maximum visibility -->
  <SkillTicker client:load />

  <main class="container mx-auto px-4 py-16">
    <div class="flex flex-col items-center justify-center min-h-[85vh] text-center space-y-6">
      
      <!-- Hero Section -->
      <div class="space-y-2">
        <p class="text-xl text-slate-400 font-mono">Hello, I'm</p>
        <h1 class="text-6xl md:text-7xl font-bold tracking-tighter">
          <span class="text-slate-200">Burak</span>
          <span class="text-[var(--color-primary)]">.Dorman</span>
        </h1>
      </div>

      <!-- Typewriter Animation -->
      <div class="h-8 text-xl md:text-2xl font-mono">
        <Typewriter client:load />
      </div>

      <!-- Location -->
      <div class="flex items-center gap-2 text-slate-500 font-mono text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
        </svg>
        Tuzla, Istanbul, Turkiye
      </div>
      
      <!-- Summary -->
      <p class="text-lg text-slate-400 max-w-3xl leading-relaxed">
        Third-year Information Systems Engineering student and hands-on developer passionate about building impactful products. I specialize in architecting AI-powered solutions and developing fast, smart algorithmic trade bots. With a strong technical foundation in Java, Typescript and Python, I bridge the gap between complex algorithms and scalable software. I am actively seeking opportunities as a Quantitative Developer, Backend Software Engineer, or AI/ML Engineer.
      </p>

      <!-- Buttons -->
      <div class="flex gap-4 pt-4">
        <!-- Resume Dropdown -->
        <div class="relative group">
          <button class="px-8 py-3 bg-[var(--color-primary)] text-slate-900 font-bold rounded hover:opacity-90 transition-opacity flex items-center gap-2">
            My Resume
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>
          
          <!-- Dropdown Menu -->
          <div class="absolute top-full left-0 mt-2 w-full bg-slate-800 border border-slate-700 rounded shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-10 overflow-hidden">
            <a href="#" class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-white text-left">PDF</a>
            <a href="#" class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-white text-left">Word</a>
            <a href="#" class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-white text-left">Markdown</a>
          </div>
        </div>

        <a href="#contact" class="px-8 py-3 border border-slate-700 rounded hover:bg-slate-800 transition-colors flex items-center gap-2">
          Contact Info
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      </div>

    </div>

    <!-- Proof of Work (Placeholder) -->
    <section id="projects" class="py-20">
      <h2 class="text-3xl font-bold mb-8 font-mono border-b border-slate-800 pb-4">
        > Proof_of_Work
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {/* Project Cards will go here */}
        <div class="bg-slate-900 border border-slate-800 p-6 rounded hover:border-[var(--color-primary)] transition-colors group">
          <div class="flex justify-between items-start mb-4">
            <h3 class="text-xl font-bold group-hover:text-[var(--color-primary)]">Relay Layer</h3>
            <span class="font-mono text-xs text-slate-500">Block #202602</span>
          </div>
          <p class="text-slate-400 mb-4">Multi-agent orchestration system for task delegation and monitoring.</p>
          <div class="flex gap-2">
            <span class="text-xs bg-slate-800 px-2 py-1 rounded font-mono">Node.js</span>
            <span class="text-xs bg-slate-800 px-2 py-1 rounded font-mono">SQLite</span>
          </div>
        </div>

         <div class="bg-slate-900 border border-slate-800 p-6 rounded hover:border-[var(--color-primary)] transition-colors group">
          <div class="flex justify-between items-start mb-4">
            <h3 class="text-xl font-bold group-hover:text-[var(--color-primary)]">WickdBot</h3>
            <span class="text-xs text-slate-500 font-mono">Block #202511</span>
          </div>
          <p class="text-slate-400 mb-4">Algorithmic trading bot applying smart money concepts to crypto markets.</p>
          <div class="flex gap-2">
            <span class="text-xs bg-slate-800 px-2 py-1 rounded font-mono">Python</span>
            <span class="text-xs bg-slate-800 px-2 py-1 rounded font-mono">Binance API</span>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>
