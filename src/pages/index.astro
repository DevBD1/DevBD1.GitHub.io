---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Burak Dorman - Software Engineer">
	<main class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 text-white">
		<div class="container mx-auto px-6 py-20">
			<div class="max-w-4xl mx-auto">
				<h1 class="text-6xl font-bold mb-6 bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">
					Burak Dorman
				</h1>
				<p class="text-2xl text-slate-300 mb-8">
					Software Engineer
				</p>
				<p class="text-lg text-slate-400 max-w-2xl">
					Building elegant solutions to complex problems. Passionate about AI/ML, full-stack development, and creating impactful products.
				</p>
			</div>
		</div>
	</main>
</Layout>
