---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Under Maintenance | Burak Dorman">
  <main class="min-h-screen bg-slate-900 flex flex-col items-center justify-center p-4 text-center">
    
    <!-- Icon or ASCII Art -->
    <div class="mb-8 animate-pulse text-emerald-500">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-24 h-24 mx-auto">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" />
      </svg>
    </div>

    <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 tracking-tight">
      System Upgrade in Progress
    </h1>
    
    <p class="text-slate-400 text-lg max-w-xl mb-8">
      Burak's portfolio is currently pivoting to a new FinTech-focused architecture. 
      <br class="hidden md:block"/>
      Migrating to <span class="text-emerald-400 font-mono">v2.0 (Market Sentiment Engine)</span>.
    </p>

    <!-- Status Box -->
    <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6 max-w-md w-full backdrop-blur-sm">
      <div class="flex justify-between items-center mb-4 border-b border-slate-700 pb-2">
        <span class="text-slate-400 text-sm font-mono">STATUS</span>
        <span class="text-emerald-400 text-sm font-mono flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          FORKING CHAIN...
        </span>
      </div>
      
      <div class="space-y-3 font-mono text-sm">
        <div class="flex justify-between">
          <span class="text-slate-500">Deployment</span>
          <span class="text-slate-300">Pending</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-500">Modules</span>
          <span class="text-slate-300">Compiling</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-500">ETA</span>
          <span class="text-slate-300">Soon™</span>
        </div>
      </div>
    </div>

    <div class="mt-12 text-slate-500 text-sm">
      <p>Need to contact me urgently?</p>
      <a href="mailto:burakdorman@gmail.com" class="text-emerald-500 hover:text-emerald-400 transition-colors font-medium">burakdorman@gmail.com</a>
    </div>

  </main>
</Layout>
