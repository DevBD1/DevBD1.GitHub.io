---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Burak Dorman - Software Engineer">
	<main class="min-h-screen bg-neutral-950 text-neutral-100">
		<!-- Animated Background -->
		<div class="fixed inset-0 overflow-hidden pointer-events-none">
			<div class="absolute top-1/4 -left-48 w-96 h-96 bg-primary-500/20 rounded-full blur-3xl animate-pulse"></div>
			<div class="absolute bottom-1/4 -right-48 w-96 h-96 bg-secondary-500/20 rounded-full blur-3xl animate-pulse delay-1000"></div>
			<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-accent-500/10 rounded-full blur-3xl animate-pulse delay-2000"></div>
		</div>

		<div class="relative z-10">
			<!-- Hero Section -->
			<section id="hero" class="min-h-screen flex items-center justify-center px-6">
				<div class="max-w-5xl mx-auto text-center">
					<div class="mb-8 inline-block">
						<span class="px-6 py-2 bg-primary-500/10 border border-primary-500/30 rounded-full text-sm font-medium backdrop-blur-sm text-primary-300">
							Available for Summer 2026 Internship
						</span>
					</div>
					
					<h1 class="text-7xl lg:text-8xl font-bold mb-6 bg-gradient-to-r from-primary-400 via-secondary-400 to-primary-400 bg-clip-text text-transparent">
						Burak Dorman
					</h1>
					
					<p class="text-3xl lg:text-4xl text-neutral-400 font-light mb-12 tracking-wide">
						Software Engineer
					</p>
					
					<div class="flex flex-wrap gap-4 justify-center">
						<a href="#contact" class="group px-8 py-4 bg-primary-600 hover:bg-primary-500 rounded-lg font-medium transition-all hover:shadow-lg hover:shadow-primary-500/50 hover:scale-105">
							<span class="flex items-center gap-2">
								Get in Touch
								<svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
								</svg>
							</span>
						</a>
						<a href="#projects" class="px-8 py-4 border border-neutral-700 hover:border-primary-500 hover:bg-primary-500/5 rounded-lg font-medium transition-all backdrop-blur-sm">
							View Projects
						</a>
					</div>
				</div>
			</section>

			<!-- Divider -->
			<div class="h-px bg-gradient-to-r from-transparent via-primary-500/30 to-transparent"></div>

			<!-- About Section -->
			<section id="about" class="min-h-screen flex items-center justify-center px-6 py-20">
				<div class="max-w-4xl mx-auto">
					<div class="flex items-center gap-4 mb-12">
						<div class="h-1 w-12 bg-gradient-to-r from-primary-500 to-secondary-500 rounded-full"></div>
						<h2 class="text-5xl font-bold text-neutral-100">
							About
						</h2>
					</div>
					<!-- Content will go here -->
				</div>
			</section>

			<!-- Divider -->
			<div class="h-px bg-gradient-to-r from-transparent via-secondary-500/30 to-transparent"></div>

			<!-- Projects Section -->
			<section id="projects" class="min-h-screen flex items-center justify-center px-6 py-20">
				<div class="max-w-6xl mx-auto w-full">
					<div class="flex items-center gap-4 mb-12">
						<div class="h-1 w-12 bg-gradient-to-r from-secondary-500 to-primary-500 rounded-full"></div>
						<h2 class="text-5xl font-bold text-neutral-100">
							Projects
						</h2>
					</div>
					<!-- Project cards will go here -->
				</div>
			</section>

			<!-- Divider -->
			<div class="h-px bg-gradient-to-r from-transparent via-accent-500/30 to-transparent"></div>

			<!-- Experience Section -->
			<section id="experience" class="min-h-screen flex items-center justify-center px-6 py-20">
				<div class="max-w-4xl mx-auto">
					<div class="flex items-center gap-4 mb-12">
						<div class="h-1 w-12 bg-gradient-to-r from-accent-500 to-primary-500 rounded-full"></div>
						<h2 class="text-5xl font-bold text-neutral-100">
							Experience
						</h2>
					</div>
					<!-- Timeline will go here -->
				</div>
			</section>

			<!-- Divider -->
			<div class="h-px bg-gradient-to-r from-transparent via-primary-500/30 to-transparent"></div>

			<!-- Skills Section -->
			<section id="skills" class="min-h-screen flex items-center justify-center px-6 py-20">
				<div class="max-w-4xl mx-auto">
					<div class="flex items-center gap-4 mb-12">
						<div class="h-1 w-12 bg-gradient-to-r from-primary-500 to-accent-500 rounded-full"></div>
						<h2 class="text-5xl font-bold text-neutral-100">
							Skills
						</h2>
					</div>
					<!-- Skill grid will go here -->
				</div>
			</section>

			<!-- Divider -->
			<div class="h-px bg-gradient-to-r from-transparent via-secondary-500/30 to-transparent"></div>

			<!-- Contact Section -->
			<section id="contact" class="min-h-screen flex items-center justify-center px-6 py-20">
				<div class="max-w-4xl mx-auto text-center">
					<div class="flex items-center gap-4 mb-12 justify-center">
						<div class="h-1 w-12 bg-gradient-to-r from-secondary-500 to-primary-500 rounded-full"></div>
						<h2 class="text-5xl font-bold text-neutral-100">
							Contact
						</h2>
						<div class="h-1 w-12 bg-gradient-to-r from-primary-500 to-secondary-500 rounded-full"></div>
					</div>
					<!-- Contact form/info will go here -->
				</div>
			</section>

			<!-- Footer -->
			<footer class="border-t border-neutral-800 py-8 px-6">
				<div class="max-w-4xl mx-auto text-center text-neutral-500 text-sm">
					© 2026 Burak Dorman. Built with Astro & Tailwind CSS.
				</div>
			</footer>
		</div>
	</main>
</Layout>

<style>
	@keyframes pulse {
		0%, 100% { opacity: 0.4; transform: scale(1); }
		50% { opacity: 0.6; transform: scale(1.05); }
	}
	
	.animate-pulse {
		animation: pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
	}
	
	.delay-1000 {
		animation-delay: 4s;
	}
	
	.delay-2000 {
		animation-delay: 6s;
	}
</style>
