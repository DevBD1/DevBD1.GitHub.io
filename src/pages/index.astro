---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Burak Dorman - Software Engineer">
	<main class="min-h-screen bg-gradient-to-br from-neutral-50 via-primary-50 to-accent-50">
		<!-- Hero Section -->
		<section class="container mx-auto px-6 py-20 lg:py-32">
			<div class="max-w-4xl mx-auto">
				<div class="mb-6">
					<span class="inline-block px-4 py-2 bg-secondary-100 text-secondary-700 rounded-full text-sm font-medium">
						Available for Summer 2026 Internship
					</span>
				</div>
				
				<h1 class="text-6xl lg:text-7xl font-bold mb-6 text-neutral-900">
					Burak Dorman
				</h1>
				
				<p class="text-2xl lg:text-3xl text-primary-600 font-medium mb-8">
					Software Engineer
				</p>
				
				<p class="text-lg text-neutral-700 max-w-2xl mb-12 leading-relaxed">
					Building elegant solutions to complex problems. Passionate about AI/ML, full-stack development, and creating impactful products that make a difference.
				</p>
				
				<div class="flex flex-wrap gap-4">
					<a 
						href="#contact" 
						class="px-8 py-4 bg-primary-500 hover:bg-primary-600 text-white rounded-lg font-medium transition-colors shadow-lg shadow-primary-500/30"
					>
						Get in Touch
					</a>
					<a 
						href="#projects" 
						class="px-8 py-4 bg-neutral-100 hover:bg-neutral-200 text-neutral-900 rounded-lg font-medium transition-colors"
					>
						View Projects
					</a>
				</div>
			</div>
		</section>

		<!-- Color Palette Preview (temporary - remove later) -->
		<section class="container mx-auto px-6 py-12">
			<div class="max-w-4xl mx-auto">
				<h2 class="text-2xl font-bold mb-6 text-neutral-900">Color Palette Preview</h2>
				
				<div class="grid grid-cols-2 md:grid-cols-5 gap-4">
					<!-- Primary -->
					<div>
						<div class="h-20 bg-primary-500 rounded-lg mb-2 shadow-md"></div>
						<p class="text-sm text-neutral-600">Primary</p>
					</div>
					
					<!-- Secondary -->
					<div>
						<div class="h-20 bg-secondary-500 rounded-lg mb-2 shadow-md"></div>
						<p class="text-sm text-neutral-600">Secondary</p>
					</div>
					
					<!-- Accent -->
					<div>
						<div class="h-20 bg-accent-500 rounded-lg mb-2 shadow-md"></div>
						<p class="text-sm text-neutral-600">Accent</p>
					</div>
					
					<!-- Neutral -->
					<div>
						<div class="h-20 bg-neutral-500 rounded-lg mb-2 shadow-md"></div>
						<p class="text-sm text-neutral-600">Neutral</p>
					</div>
					
					<!-- Dark -->
					<div>
						<div class="h-20 bg-dark-900 rounded-lg mb-2 shadow-md"></div>
						<p class="text-sm text-neutral-600">Dark</p>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
