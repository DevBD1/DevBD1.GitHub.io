---
import type { ProjectType } from '../data/projects';

export interface Props {
  title: string;
  description: string;
  blockHeight: string;
  hash: string;
  gas: string;
  stack: string[];
  link?: string;
  status?: 'Confirmed' | 'Pending' | 'Failed';
  type: ProjectType;
  aiAssisted?: boolean;
}

const {
  title,
  description,
  blockHeight,
  hash,
  gas,
  stack,
  link,
  status = 'Confirmed',
  type,
  aiAssisted = false,
} = Astro.props;

const typeConfig: Record<ProjectType, { label: string; color: string; bgColor: string }> = {
  production: {
    label: 'Production',
    color: '#10b981',
    bgColor: 'rgba(16, 185, 129, 0.15)',
  },
  research: {
    label: 'Research',
    color: '#8b5cf6',
    bgColor: 'rgba(139, 92, 246, 0.15)',
  },
  experiment: {
    label: 'Experiment',
    color: '#f59e0b',
    bgColor: 'rgba(245, 158, 11, 0.15)',
  },
};

const typeStyle = typeConfig[type];

const statusColor =
  status === 'Confirmed'
    ? 'text-emerald-500'
    : status === 'Pending'
      ? 'text-amber-500'
      : 'text-red-500';
---

<a
  href={link || '#'}
  target="_blank"
  rel="noopener noreferrer"
  class="project-card block p-6 rounded-lg transition-all duration-300 hover:-translate-y-1"
  style="background-color: rgba(15, 23, 42, 0.5); border: 1px solid var(--color-accent);"
>
  <!-- Header: Type Badge, Hash & Block -->
  <div class="flex justify-between items-start mb-4 font-mono text-xs border-b pb-2"
       style="color: var(--color-secondary); border-color: var(--color-accent);">
    <div class="flex items-center gap-2 flex-wrap">
      <!-- Project Type Badge -->
      <span
        class="px-2 py-0.5 rounded font-medium"
        style={{
          backgroundColor: typeStyle.bgColor,
          color: typeStyle.color,
          border: `1px solid ${typeStyle.color}40`,
        }}
      >
        {typeStyle.label}
      </span>

      <!-- AI Badge (if applicable) -->
      {aiAssisted && (
        <span
          class="px-2 py-0.5 rounded font-medium"
          style={{
            backgroundColor: 'rgba(236, 72, 153, 0.15)',
            color: '#ec4899',
            border: '1px solid rgba(236, 72, 153, 0.4)',
          }}
          title="AI collaboration: Architecture/design assisted by AI, implementation by engineer"
        >
          AI+
        </span>
      )}

      <span style="color: var(--color-secondary); opacity: 0.7;">Tx:</span>
      <span class="transition-colors" style="color: var(--color-secondary);">{hash}</span>
    </div>
    <div style="color: var(--color-secondary);">{blockHeight}</div>
  </div>

  <!-- Body: Title & Desc -->
  <div class="mb-4">
    <div class="flex justify-between items-start">
      <h3 class="project-card__title text-xl font-bold mb-2 transition-colors" style="color: var(--color-text-base);">
        {title}
      </h3>
      <span class={`text-xs font-mono px-2 py-0.5 rounded ${statusColor}`}
            style="border: 1px solid var(--color-accent);">
        {status}
      </span>
    </div>
    <p class="text-sm leading-relaxed" style="color: var(--color-secondary);">{description}</p>
  </div>

  <!-- Footer: Metadata & Stack -->
  <div class="mt-6 pt-4 flex flex-col gap-3" style="border-top: 1px solid var(--color-accent);">
    <div class="flex justify-between text-xs font-mono" style="color: var(--color-secondary);">
      <span>
        Gas Used: <span style="color: var(--color-text-base);">{gas}</span>
      </span>
      <span>
        From: <span style="color: var(--color-text-base);">0xBurak</span>
      </span>
    </div>

    <div class="flex flex-wrap gap-2">
      {stack.map((tech) => (
        <span
          class="px-2 py-1 text-xs font-mono rounded"
          style="background-color: rgba(15, 23, 42, 0.5); color: var(--color-text-base); border: 1px solid var(--color-accent);"
        >
          {tech}
        </span>
      ))}
    </div>
  </div>
</a>
